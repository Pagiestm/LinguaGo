{
  "name": "linguago",
  "version": "1.2.0",
  "private": true,
  "description": "LinguaGo – apprendre l'anglais avec une PWA (Vue 3 + NestJS)",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run start:dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run start:dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w server",
    "test:unit": "npm run test:unit -w client",
    "test:cov": "npm run test:cov -w server",
    "test:e2e": "npm run test:e2e -w client",
    "db:migrate": "npm run migrate:dev -w server",
    "db:seed": "npm run seed -w server"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "semantic-release": "25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  }
}
