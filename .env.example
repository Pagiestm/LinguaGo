# Base de données (le conteneur Docker Compose écoute sur 5435)
DATABASE_URL="postgresql://postgres:root@localhost:5435/linguago"

# Serveur
PORT=3000
CLIENT_URL="http://localhost:5173"

# Secret des jetons d'accès : au moins 32 caractères
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="remplacez-moi-par-une-valeur-aleatoire-de-48-octets"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Domaine des cookies en production (vide en local)
COOKIE_DOMAIN=""

# https://aistudio.google.com/app/apikey

# Notifications push (facultatif) : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@example.com"

# Client : adresse de l'API vue du navigateur (réécrite vers le serveur par Vite ou Vercel)
VITE_API_URL="/api"

# Docker Compose : port publié du client (l'API utilise PORT ci-dessus)
# CLIENT_PORT=5173

# Tests de bout en bout de l'API : une base dédiée, vidée à chaque exécution
DATABASE_URL_TEST="postgresql://postgres:root@localhost:5435/linguago_test"

# Connexion avec Google (facultatif) : https://console.cloud.google.com/apis/credentials
# L'URL de rappel à déclarer chez Google est GOOGLE_CALLBACK_URL
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Envoi d'emails (mot de passe oublié). En local, Mailpit lit tout sur http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="LinguaGo <no-reply@linguago.test>"

# Suivi des erreurs (facultatif) : un DSN Sentry côté API et un côté client
SENTRY_DSN=""
VITE_SENTRY_DSN=""
